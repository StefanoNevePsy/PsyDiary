# Copia in .env.local per provare in locale la versione collegata al custode.
# Sul sito pubblicato questi valori arrivano dalle variabili del repository
# su GitHub (Settings → Secrets and variables → Actions → Variables).
VITE_CUSTODE_URL=https://script.google.com/macros/s/.../exec
VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Corsia veloce (Firebase, facoltativa): la configurazione di PsyDiary è già nel codice (src/lib/centro/config.js)
# e non è segreta. Solo se serve cambiarla al momento della build:
# VITE_FIREBASE=off                 spegne del tutto la corsia veloce
# VITE_FIREBASE_API_KEY=...         (e _AUTH_DOMAIN, _PROJECT_ID, _APP_ID, _MESSAGING_SENDER_ID, _STORAGE_BUCKET)
# Solo in locale con VITE_ACCESSO_DEV=1: punta agli emulatori (vedi docs/firebase.md)
# VITE_FIREBASE_PROJECT_ID=demo-psydiary
# VITE_FIREBASE_EMULATORE=127.0.0.1:8085,127.0.0.1:9099
